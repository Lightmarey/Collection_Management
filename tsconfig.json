{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": ["node", "vite/client", "@electron-forge/plugin-vite/forge-vite-env"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "forge.config.ts", "vite.*.config.mts"]
}
