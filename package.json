{
  "name": "knowledge-management",
  "productName": "Innerse",
  "version": "1.1.0",
  "description": "Local-first reading inbox for turning saved content into understanding",
  "author": "Lightmarey",
  "license": "AGPL-3.0-only",
  "private": true,
  "main": ".vite/build/main.js",
  "scripts": {
    "prestart": "node scripts/clean-vite.mjs",
    "start": "electron-forge start",
    "prepackage": "node scripts/check-packaging-node.mjs",
    "package": "electron-forge package",
    "premake": "node scripts/check-packaging-node.mjs",
    "make": "electron-forge make",
    "postmake": "node scripts/verify-distribution.mjs all",
    "premake:installer": "node scripts/check-packaging-node.mjs",
    "make:installer": "electron-forge make --targets @electron-forge/maker-wix",
    "postmake:installer": "node scripts/verify-distribution.mjs installer",
    "premake:portable": "node scripts/check-packaging-node.mjs",
    "make:portable": "electron-forge make --targets @electron-forge/maker-zip",
    "postmake:portable": "node scripts/verify-distribution.mjs portable",
    "premake:linux": "node scripts/check-packaging-node.mjs",
    "make:linux": "electron-forge make --targets @electron-forge/maker-deb,@electron-forge/maker-rpm",
    "postmake:linux": "node scripts/verify-distribution.mjs linux",
    "test": "node --test test/*.test.mjs",
    "test:zhihu-headless": "electron scripts/zhihu-headless-check.mjs",
    "test:zhihu-chain": "electron scripts/zhihu-headless-check.mjs --verify-incremental",
    "test:zhihu-signature-live": "electron scripts/zhihu-signature-check.mjs",
    "test:smoke": "node scripts/electron-smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^13.0.3",
    "dompurify": "^3.4.13",
    "jsdom": "^30.0.1",
    "katex": "^0.18.4",
    "lucide-react": "^1.31.0",
    "lxgw-wenkai-webfont": "^1.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-wix": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "electron": "^43.3.0",
    "typescript": "^5.8.3",
    "vite": "^7.3.6"
  },
  "overrides": {
    "@electron/rebuild": "^4.2.0"
  }
}
